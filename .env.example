# Copy this file to `.env.local` for local dev, OR set the same variables
# in Cloudflare Pages → Settings → Environment variables for production.
#
# Note: Vite only exposes vars prefixed with VITE_ to the browser bundle.

# Google Maps Platform — used by the address autocomplete in PostDealModal.
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable: "Places API (New)"
# Restrict the key to your domains (HTTP referrer):
#   - https://allstreetlive.com/*
#   - https://*.allstreetlive.com/*
#   - http://localhost:5173/*   (for local dev)
VITE_GOOGLE_MAPS_API_KEY=
